#!/usr/bin/env bash
# Worker-contract hook shim (ADR 0005/0007): buffer stdin, resolve the interpreter by the
# PINNED order, and run the module, which branches on the stdin hook_event_name. Registered
# for SubagentStart (no matcher) and PreToolUse(Agent) in hooks/hooks.json.
#
# Interpreter resolution is the shared _interpreter.sh rungs 1-3 (recorded python-path ->
# $CHINAMAXM_PYTHON -> ~/miniconda3/envs/chinamaxM python), then a fail-open `conda run`:
#   1) the setup-recorded python-path    (<claude-root>/chinamaxM/python-path)  [now FIRST]
#   2) $CHINAMAXM_PYTHON                  (an absolute executable python)
#   3) ~/miniconda3/envs/chinamaxM python (absolute env interpreter)
#   4) conda run -n chinamaxM python      (last resort — costs seconds per spawn)
# The RECORDED path now wins over $CHINAMAXM_PYTHON — a deliberate flip of the previous
# shim-local order so all shims share ONE discovery order (ADR 0009 as amended 2026-08-14).
# Hooks NEVER use the launcher's bootstrap/ambient rungs (5-6). There is no `set -e`: the
# module always exits 0, and the shim exits 0 unconditionally so a hook fault can never block
# a tool call (fail-open).
set -uo pipefail

MODULE="chinamaxM.hooks.worker_contract"
# Host token: selects the Claude Worker contract (item 5 pushes the final report to main
# via SendMessage — ADR 0007 as amended 2026-08-18). The module defaults to claude anyway.
HOST="claude"
payload="$(cat)"

CHINAMAXM_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=scripts/_interpreter.sh
. "${CHINAMAXM_SCRIPT_DIR}/_interpreter.sh"

if py="$(chinamaxm_resolve_python)"; then
  printf '%s' "${payload}" | "${py}" -m "${MODULE}" "${HOST}"
  exit 0
fi

conda_cmd="$(chinamaxm_conda_cmd || true)"
if [ -n "${conda_cmd}" ]; then
  # `--no-capture-output` is REQUIRED: plain `conda run` swallows stdin, so the module
  # would read an empty event and inject nothing. It connects stdio directly instead.
  printf '%s' "${payload}" | "${conda_cmd}" run --no-capture-output -n chinamaxM python -m "${MODULE}" "${HOST}"
  exit 0
fi

echo "chinamaxM worker_contract_hook: no interpreter resolved (set CHINAMAXM_PYTHON, record a python-path, or create the chinamaxM conda env)" >&2
exit 0
