#!/usr/bin/env bash
# Codex worker-contract hook shim (ADR 0005/0007): buffer stdin, TRANSLATE the Codex hook
# payload into the shape the shared Claude-side module expects, then pipe it to that same
# module. Registered for SubagentStart (no matcher) and PreToolUse(spawn_agent) in
# hooks/codex-hooks.json. The contract/matcher live ENTIRELY in the shared module — this
# shim only remaps field names, never re-implementing the match or the contract text.
#
# Translation (Codex payload -> chinamaxM.hooks.worker_contract shape):
#   * SubagentStart: none — the role identity already rides top-level `agent_type`, which
#     the module reads directly.
#   * PreToolUse: `tool_name` "spawn_agent" -> "Agent" (the module gates on == "Agent"),
#     and `tool_input.agent_type` -> `tool_input.subagent_type` (the module reads that key).
# A malformed payload is passed through unchanged so the module fails open on it.
#
# Interpreter resolution is PINNED and never probed beyond this order — the first is used
# (identical to scripts/worker_contract_hook):
#   1) $CHINAMAXM_PYTHON                 (an absolute executable python)
#   2) the setup-recorded python-path    (<claude-root>/chinamaxM/python-path)
#   3) conda run -n chinamaxM python      (last resort — costs seconds per spawn)
# There is no `set -e`: the module always exits 0, and the shim exits 0 unconditionally so
# a hook fault can never block a tool call (fail-open).
set -uo pipefail

MODULE="chinamaxM.hooks.worker_contract"
payload="$(cat)"

# A stdlib-only translator: read the Codex payload on stdin, remap the PreToolUse fields,
# and write the translated JSON on stdout. A parse failure echoes the raw payload so the
# module downstream produces the fail-open stderr diagnostic. No single quotes inside, so
# the whole program can ride a single-quoted bash string.
TRANSLATE='
import sys, json
raw = sys.stdin.read()
try:
    ev = json.loads(raw)
    if isinstance(ev, dict) and ev.get("hook_event_name") == "PreToolUse":
        if ev.get("tool_name") == "spawn_agent":
            ev["tool_name"] = "Agent"
        ti = ev.get("tool_input")
        if isinstance(ti, dict) and "subagent_type" not in ti and isinstance(ti.get("agent_type"), str):
            ti["subagent_type"] = ti["agent_type"]
    sys.stdout.write(json.dumps(ev))
except Exception:
    sys.stdout.write(raw)
'

# Rungs 1-2: print an absolute executable python, or return 1 to fall through to conda.
resolve_python() {
  if [ -n "${CHINAMAXM_PYTHON:-}" ] && [ -x "${CHINAMAXM_PYTHON}" ]; then
    printf '%s\n' "${CHINAMAXM_PYTHON}"
    return 0
  fi
  local claude_root recorded_file recorded
  claude_root="${CHINAMAXM_CLAUDE_HOME:-${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}}"
  recorded_file="${claude_root}/chinamaxM/python-path"
  if [ -f "${recorded_file}" ]; then
    recorded="$(head -n1 "${recorded_file}" 2>/dev/null | tr -d '\r\n')"
    if [ -n "${recorded}" ] && [ -x "${recorded}" ]; then
      printf '%s\n' "${recorded}"
      return 0
    fi
  fi
  return 1
}

if py="$(resolve_python)"; then
  printf '%s' "${payload}" | "${py}" -c "${TRANSLATE}" | "${py}" -m "${MODULE}"
  exit 0
fi

if command -v conda >/dev/null 2>&1; then
  # `--no-capture-output` is REQUIRED: plain `conda run` swallows stdin, so the stage would
  # read an empty payload. It connects stdio directly instead.
  printf '%s' "${payload}" \
    | conda run --no-capture-output -n chinamaxM python -c "${TRANSLATE}" \
    | conda run --no-capture-output -n chinamaxM python -m "${MODULE}"
  exit 0
fi

echo "chinamaxM codex_worker_contract_hook: no interpreter resolved (set CHINAMAXM_PYTHON, record a python-path, or create the chinamaxM conda env)" >&2
exit 0
