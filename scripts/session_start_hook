#!/usr/bin/env bash
# SessionStart hook shim (ADR 0005/0009): resolve the interpreter by the PINNED order and run
# the warn-only module, which ignores stdin. Registered for SessionStart (matcher
# startup|resume|clear|compact|fork) in hooks/hooks.json.
#
# Interpreter resolution is PINNED and never probed beyond this order — the first is used:
#   1) $CHINAMAXM_PYTHON                 (an absolute executable python)
#   2) the setup-recorded python-path    (<claude-root>/chinamaxM/python-path)
#   3) conda run -n chinamaxM python      (last resort — costs seconds per spawn)
# There is no `set -e`: the module always exits 0, and the shim exits 0 unconditionally so a
# hook fault can never block a session start (warn-only, fail-open).
set -uo pipefail

MODULE="chinamaxM.hooks.session_start"
payload="$(cat)"

# Rungs 1-2: print an absolute executable python, or return 1 to fall through to conda.
resolve_python() {
  if [ -n "${CHINAMAXM_PYTHON:-}" ] && [ -x "${CHINAMAXM_PYTHON}" ]; then
    printf '%s\n' "${CHINAMAXM_PYTHON}"
    return 0
  fi
  local claude_root recorded_file recorded
  claude_root="${CHINAMAXM_CLAUDE_HOME:-${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}}"
  recorded_file="${claude_root}/chinamaxM/python-path"
  if [ -f "${recorded_file}" ]; then
    recorded="$(head -n1 "${recorded_file}" 2>/dev/null | tr -d '\r\n')"
    if [ -n "${recorded}" ] && [ -x "${recorded}" ]; then
      printf '%s\n' "${recorded}"
      return 0
    fi
  fi
  return 1
}

if py="$(resolve_python)"; then
  printf '%s' "${payload}" | "${py}" -m "${MODULE}"
  exit 0
fi

if command -v conda >/dev/null 2>&1; then
  # `--no-capture-output` connects stdio directly (plain `conda run` swallows it).
  printf '%s' "${payload}" | conda run --no-capture-output -n chinamaxM python -m "${MODULE}"
  exit 0
fi

echo "chinamaxM session_start_hook: no interpreter resolved (set CHINAMAXM_PYTHON, record a python-path, or create the chinamaxM conda env)" >&2
exit 0
